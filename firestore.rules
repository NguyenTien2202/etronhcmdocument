rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isHr() {
      return request.auth != null && request.auth.uid == 'TmtCY7Bgb2OSPRZXhsK1qRnoI8g1';
    }
    function validToken(token) { return token.matches('^[a-f0-9]{64}$'); }
    function activeLink(token) {
      return validToken(token) && exists(/databases/$(database)/documents/onboarding_links/$(token));
    }

    // SalesHub remains public. Document deletion uses a recoverable deletedAt flag.
    match /documents/{id} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /document_files/{id} { allow read, write: if true; }
    match /callbot_templates/{id} { allow read, write: if true; }
    match /callbot_media/{id} { allow read, write: if true; }
    match /config/{id} {
      allow read, write: if id in ['products', 'categories', 'callbot_keywords'];
    }

    match /hr_config/onboarding_roadmap {
      allow read: if true;
      allow write: if isHr();
    }
    match /hr_config/{id} {
      allow read, write: if isHr();
    }
    // A random link is a bearer credential. It contains only learning information.
    match /onboarding_links/{token} {
      allow get: if validToken(token);
      allow list, delete: if isHr();
      allow create, update: if isHr() && validToken(token)
        && request.resource.data.keys().hasOnly(['fullName', 'role', 'startDate', 'mentor', 'targetDate', 'customRoadmap'])
        && request.resource.data.fullName is string
        && request.resource.data.role is string
        && request.resource.data.startDate is string
        && request.resource.data.mentor is string
        && request.resource.data.targetDate is string
        && request.resource.data.customRoadmap is list;
    }
    match /onboarding_progress/{token} {
      allow get: if isHr() || activeLink(token);
      allow list, delete: if isHr();
      allow create, update: if (isHr() || activeLink(token))
        && request.resource.data.keys().hasOnly(['completedTasks', 'taskSubmissions'])
        && request.resource.data.completedTasks is map
        && request.resource.data.completedTasks.size() <= 300
        && request.resource.data.completedTasks.values().hasOnly([true, false])
        && (!('taskSubmissions' in request.resource.data)
            || (request.resource.data.taskSubmissions is map && request.resource.data.taskSubmissions.size() <= 100));
    }
    // Homework file chunks: id = {token}_{fileId}_{index}. Immutable; private to HR and the link holder.
    function validFileChunk(id) {
      let d = request.resource.data;
      return id.matches('^[a-f0-9]{64}_[a-f0-9]{16,32}_([0-9]|[1-9][0-9])$')
        && d.keys().hasAll(['token', 'fileId', 'index', 'total', 'data'])
        && d.keys().hasOnly(['token', 'fileId', 'index', 'total', 'data'])
        && d.token is string && validToken(d.token)
        && d.fileId is string && d.fileId.matches('^[a-f0-9]{16,32}$')
        && d.index is int && d.total is int
        && d.total >= 1 && d.total <= 40
        && d.index >= 0 && d.index < d.total
        && id == d.token + '_' + d.fileId + '_' + string(d.index)
        && d.data is string && d.data.size() <= 700000;
    }
    match /onboarding_files/{id} {
      allow get, delete: if isHr() || activeLink(resource.data.token);
      allow list: if isHr();
      allow create: if (isHr() || activeLink(request.resource.data.token)) && validFileChunk(id);
      allow update: if false;
    }
    // Deny all other collections, including legacy/private HR data.
    match /{document=**} { allow read, write: if false; }
  }
}
